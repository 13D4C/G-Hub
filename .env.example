MONGODB_URI=mongodb://127.0.0.1:27017/g-hub
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only needed when the public URL differs from the request host (e.g. behind a proxy).
# GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback

# SeaweedFS S3 gateway (remote server running `weed s3`)
SEAWEED_S3_ENDPOINT=http://your-server-ip:8333
SEAWEED_S3_REGION=us-east-1
SEAWEED_S3_ACCESS_KEY=your-access-key
SEAWEED_S3_SECRET_KEY=your-secret-key
SEAWEED_S3_BUCKET=g-hub-media
# Optional: public base URL the browser uses to fetch media (defaults to SEAWEED_S3_ENDPOINT)
# SEAWEED_PUBLIC_URL=http://your-server-ip:8333
