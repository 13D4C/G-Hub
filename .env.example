MONGODB_URI=mongodb://127.0.0.1:27017/g-hub
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only needed when the public URL differs from the request host (e.g. behind a proxy).
# GOOGLE_REDIRECT_URI=https://example.com/api/auth/google/callback

S3_BUCKET=g-hub-media
AWS_REGION=us-east-1
S3_ENDPOINT=http://your-server-ip:8333
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

DATA_BACKEND=mongo
DYNAMODB_TABLE_PREFIX=g-hub
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_ACCESS_KEY_ID=local
DYNAMODB_SECRET_ACCESS_KEY=local

# Stripe channel subscriptions (test mode only — a live secret key is rejected)
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: only needed when the public URL differs from the request host, so
# Checkout returns the viewer to the right origin (same idea as GOOGLE_REDIRECT_URI).
# APP_URL=https://example.com

# Seed only: the demo channel `npm run seed` creates and assigns its videos to.
SEED_CREATOR_EMAIL=creator@g-hub.local
SEED_CREATOR_NAME=Demo Channel
# Monthly channel fee in cents (499 = $4.99).
SEED_CHANNEL_PRICE_CENTS=499

# Video transcoding (HLS/DASH).
#
# Every value below is the one the code already defaults to, so copying this block into
# .env changes nothing until you edit a value. Nothing here is required: with no
# ffmpeg installed the worker says so once and stays idle, and every video plays from its
# original upload exactly as it did before this pipeline existed.
#
# What IS required to transcode is ffmpeg itself, which is not a variable:
#   Windows dev: winget install Gyan.FFmpeg   (then restart the shell)
#   Container:   installed by the Dockerfile's `apk add --no-cache ffmpeg`
# Where the binaries are. Found on PATH by default.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Whether the app process transcodes in-process. On by default, so an upload is transcoded
# with nothing else running. Set to 0 where the web process should not compete with ffmpeg
# for CPU — `npm run transcode-worker` then does the work instead.
TRANSCODE_INLINE=1
# How many videos one process encodes at once. Each encode is already capped at 2 threads.
TRANSCODE_CONCURRENCY=1
# How long a video being encoded stays reserved for its worker, in seconds. The worker
# renews it every fifth of this, so it only runs out when a worker has stopped — a crash,
# or restarting the dev server mid-encode — and a shorter lease picks such a video back up
# sooner. Minimum 30. Worth lowering in development, e.g. to 60.
TRANSCODE_LEASE_SECONDS=300
# The wait before retrying a failed video, in seconds; each further failure waits five
# times longer. Worth lowering in development, e.g. to 10: there a failure is usually a
# bug you have just fixed, not something that waiting will clear.
TRANSCODE_RETRY_BASE_SECONDS=60
# Sources larger than this are marked `skipped` rather than filling the disk.
TRANSCODE_MAX_SOURCE_MB=2048
# Where the source and the segment tree are staged. Unset means the OS temp directory,
# which is the right answer on both Windows and Alpine — only set this to point at a
# mounted volume.
TRANSCODE_TMP_DIR=
# Origins allowed to fetch media from the bucket in a browser, comma-separated. Largely moot
# now that browsers fetch media through the app's own /api/media route (same-origin, no CORS
# needed). Applied by `npm run set-bucket-cors`.
S3_CORS_ORIGINS=*

# Signed media urls (anti-piracy).
#
# Every video, segment and ad the browser loads comes from /api/media/<token>/..., a signed url
# that expires and is bound to the viewer's session. Nothing here is required: with both unset,
# the signing key is derived from SESSION_SECRET and urls live two hours.
#
# The key that signs media urls, 32+ characters. Unset derives one from SESSION_SECRET; set it
# to rotate media urls without logging everybody out. Changing it invalidates every url issued.
# MEDIA_SIGNING_SECRET=
# How long a playback url stays valid, in seconds. Always stretched to cover twice the video's
# length plus ten minutes, so a long video is never cut off mid-watch. Minimum 60 — lower it in
# development, e.g. to 60, to watch an expired url being renewed.
# MEDIA_URL_TTL_SECONDS=7200
#
# Once the bucket should be private, remove anonymous read on the SeaweedFS host and check it
# with `npm run check:media-private`.
